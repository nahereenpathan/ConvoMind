# ===================================================================
# ConvoMind Production Environment Configuration Template
# Instructions: Copy this file to '.env.production' on your VPS deployment server.
# Replace all placeholder values with actual production secrets.
# ===================================================================

# Application Identity & Mode
APP_NAME=ConvoMind API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=convomind_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_GENERATE_VIA_OPENSSL
POSTGRES_DB=convomind_prod_db
DATABASE_URL=postgresql+asyncpg://convomind_prod_user:REPLACE_WITH_STRONG_RANDOM_PASSWORD_GENERATE_VIA_OPENSSL@postgres:5432/convomind_prod_db

# Redis & Celery Task Queue
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS Allowed Origins (Comma-separated list of your production domains)
CORS_ORIGINS=https://convomind.com,https://app.convomind.com

# JWT Authentication Security
# Generate high-entropy 256-bit key: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_256_BIT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Media Storage Configuration
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=500

# AI Transcription Provider (OpenAI Whisper)
TRANSCRIPTION_PROVIDER=whisper
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
WHISPER_MODEL=whisper-1

# AI LLM Intelligence Provider (OpenAI GPT-4o-mini)
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
MAX_TRANSCRIPT_TOKENS=100000

# AI Embedding & RAG Vector Provider
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_CHUNK_SIZE=500
EMBEDDING_CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=50

# Speaker Diarization Provider (Pyannote / Mock)
DIARIZATION_PROVIDER=mock
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_HF_TOKEN=hf_YOUR_HUGGINGFACE_READ_TOKEN_HERE

# Production SMTP Email Service
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_OR_MAILGUN_API_KEY
SMTP_FROM_EMAIL=noreply@convomind.com
SMTP_USE_TLS=true

# Production Razorpay SaaS Billing Credentials
# Get live/test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_YOUR_RAZORPAY_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_KEY
