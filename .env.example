APP_NAME=ConvoMind API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://convo_user:convo_password@postgres:5432/convo_db

REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

CORS_ORIGINS=http://localhost:5173

JWT_SECRET_KEY=change-this-in-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

TRANSCRIPTION_PROVIDER=whisper
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1

APP_BASE_URL=http://localhost:5173

# SMTP Email Dispatch Settings
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@convomind.ai
SMTP_FROM_NAME=ConvoMind
SMTP_USE_TLS=true

# Razorpay Production SaaS Billing Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx
